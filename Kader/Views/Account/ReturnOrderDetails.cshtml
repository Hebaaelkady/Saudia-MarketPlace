@model Kader.DTOs.ReturnOrders.ReturnsOrdersDto

@{
    ViewData["Title"] = "Return Order";
}
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
                <a class="breadcrumb-item text-dark" asp-controller="Account" asp-action="Orders">طلباتي</a>
                <span class="breadcrumb-item active">إرجاع الطلب</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
            @Html.Partial("_sidebar", Model)
        </div>
        <div class="col-lg-8">
            <h5 class="section-title position-relative text-uppercase mb-3">
                <span class="bg-secondary pr-3">إرجاع الطلب</span>
            </h5>
            <div>
                @if (ViewBag.message!=null)
                {
                    @ViewBag.message
                }
            </div>
            <div class="bg-light p-30 mb-5">
                <form asp-action="ReturnOrderDetails" method="post">
                    <input type="hidden" name="Idordersss" value="@Model.Idordersss" />

                    <table class="table table-light table-borderless table-hover text-center mb-0">
                        <thead class="thead-dark" style="font-size:12px">
                            <tr>
                                <th>اسم المنتج</th>
                                <th>السعر</th>
                                <th>الكميّة</th>
                               
                                <th>سبب الإرجاع</th>
                                <th>اختار</th>
                            </tr>
                        </thead>
                        <tbody class="align-middle">
                            @for (int i = 0; i < Model.Itemslist.Count; i++)
                            {
                                var item = Model.Itemslist[i];
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@{double d=item.PriceItem+ item.ShippingPrice;}@d</td>
                                    <td>@item.Quantity</td>
                                  
                                    <td>
                                        <select name="ReturnsOrderItem[@i].Reason" class="form-control" @(item.HasExistingReturn ? "disabled" : "")>
                                            <option value="">اختر السبب</option>
                                            <option value="1">المنتج تالف.</option>
                                            <option value="2">المنتج مختلف عن المطلوب</option>
                                            <option value="3">تغيير الرأي</option>
                                            <option value="4">عدم التوافق مع الوصف</option>
                                            <option value="5">شراء مكرر</option>
                                            <option value="6">المنتج وصل بعد الموعد المتوقع ولم يعد العميل بحاجة إليه</option>
                                        </select>  <span asp-validation-for="ReturnsOrderItem[@i].Reason" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <input type="checkbox" name="ReturnsOrderItem[@i].Selected" value="true" @(item.HasExistingReturn ? "disabled" : "") />
                                        <input type="hidden" name="ReturnsOrderItem[@i].OrderItemsId" value="@item.OrderItemsId" />
                                        <span asp-validation-for="ReturnsOrderItem[@i].Selected" class="text-danger"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                    <div class="mt-3 text-right">
                        <button type="submit" class="btn btn-primary">إرسال طلب الإرجاع</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
