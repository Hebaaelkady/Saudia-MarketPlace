 
@using Kader.DTOs.Users
@model AllUserViewDto
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <nav aria-label="Breadcrumb">
        <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>اضافة مستخدم  جديد </span>
    </nav>
</div>
@{
    var roles = ViewBag.Roles as IEnumerable<SelectListItem>;
    }

   
 
    <div class="container col-md-5">
        <div class="box ">
        <form asp-controller="Account" asp-action="Register" method="post">

            <h3>اضافة مستخدم  جديد</h3>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @Html.Raw(ViewBag.SuccessMessage)
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="form-group">
            <label> اسم الاول</label>
            <input type="text" asp-for="FirstName" name="FirstName" class="form-control" id="AimsDD" />
            <span asp-validation-for="FirstName" class="text-danger"></span>

        </div>
        <div class="form-group">
            <label> اسم الاخير</label>
            <input type="text" asp-for="LastName" name="LastName" class="form-control" id="AimsDD" />
            <span asp-validation-for="LastName" class="text-danger"></span>

        </div>
        <div class="form-group">
            <label> البريد الالكتروني</label>
            <input type="text" asp-for="Email" name="Email" class="form-control" id="AimsDD" />
            <span asp-validation-for="Email" class="text-danger"></span>

        </div>
            <div class="form-group">
                <label>كود البلد</label>
                <div class="form-group">
                    <label>رقم الهاتف</label>
                    <div class="input-group">
