        </div>
        <div class="form-group">
            <label>كلمة السر</label>
            <input type="password" asp-for="Password" name="Password" class="form-control" id="AimsDD1" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
         
                <div class="form-group">
                    <div  >
                    <button class="btn btn-block btn-primary font-weight-bold py-3" type="submit" value="">تسجيل</button>
                    </div>
                </div>

     </form>
    </div></div>
 
   