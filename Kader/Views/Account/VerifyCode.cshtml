      @model string
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container">
    <nav aria-label="Breadcrumb">
        <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>أدخل رمز التحقق</span>
    </nav>
</div>
<div class="container col-md-5">
    <div class="box ">
        <h3>أدخل رمز التحقق </h3>





        <form asp-action="VerifyCode" method="post">
    <label for="otpCode">رمز التحقق:</label>
    <input type="text" name="otpCode" required class="form-control" />

    <button type="submit" class="btn btn-primary">تحقق</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

    </div>
    <div class="clear"></div>
</div>
   
 



 
