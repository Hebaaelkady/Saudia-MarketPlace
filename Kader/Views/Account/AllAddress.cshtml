@model List<Kader.DTOs.Address.AddressDto>
@using Kader.Infrastructure.Shared;

@{
    ViewData["Title"] = "View";
}
@{
    Infrastructure.Shared.Interfaces.IKeys _keys = new Infrastructure.Shared.Implementations.Keys();
}
<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
                <a class="breadcrumb-item text-dark" href="#">حسابي  </a>
                <span class="breadcrumb-item active">جميع العناوين</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
@Html.Partial("_sidebar", Model)
        </div>
        <div class="col-lg-8">
 
    @if (Model != null)
    {
        <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">العناوين الافتراضية</span></h5>
        <div class="bg-light p-30 mb-5">
        <h6 class="mb-3">بيانات الاتصال</h6>
        @Html.ActionLink("اضافة عنوان جديد", "AddAddress", null)
        <table class="table table-light table-borderless table-hover text-center mb-0">
            <thead class="thead-dark" style="font-size:12px">
                <tr>
                    <th>  المدينة</th>
                    <th>  الحي</th>
                    <th>العنوان</th>
                    <th>رقم المبني</th>
                    <th> الرقم الاضافي</th>
                    <th>تليفون اخر</th>
                    <th>وقت التوصيل المناسب</th>
                    <th></th>
                     
                    <th></th>
                    <th></th>
                </tr>
            </thead>
                <tbody class="align-middle">
                @foreach (var item in Model)
                {
                            var rowClass = item.IsMain.HasValue && item.IsMain.Value ? "main-address" : "";
                            <tr class="@rowClass">
                                    <td class="align-middle">
                                @item.CityName
                                </td>
                                    <td class="align-middle">
                                        @item.Name
                                </td>
                                    <td class="align-middle"> @item.AddressStreet</td>
                                    <td class="align-middle"> @item.BuildingNo</td>
                                    <td class="align-middle">
                                        @item.BuildingNo1
                            </td>

                                    <td class="align-middle">
                                @item.SecondryPhone
                            </td>
                                    <td class="align-middle">
                                @if (item.ShiftDelivary == @_keys.MorningShift())
                                {
                                    <span>@_keys.MorningShiftText() </span>
                                }
                                else if (item.ShiftDelivary == @_keys.NightShift())
                                {
                                    <span>@_keys.NightShiftText() </span>
                                }
                            </td>
                                    <td class="align-middle">
                                        @if (item.IsMain==true)
                                    {
                                        <span>العنوان الرئيسي</span>
                                    }
                                </td>
                                    <td class="align-middle">
                                @Html.ActionLink("تعديل", "AddAddress", new { AddressId = item.AddressId }, null)
                     </td>
                 </tr>
                    }
                    </tbody>
                </table>
        </div>
    }
        </div>

    </div>
</div>
 <div class="clear"></div>
