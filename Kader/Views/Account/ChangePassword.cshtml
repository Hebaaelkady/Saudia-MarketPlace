 
 


@using Kader.DTOs.Users
@model ChangePasswordDto
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
                <a class="breadcrumb-item text-dark" href="#">حسابي  </a>
                <span class="breadcrumb-item active">تغيير كلمة المرور</span>
            </nav>
        </div>
    </div>
</div>
<div class="clear"></div>
<div class="clear"></div>
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
            @Html.Partial("_sidebar", Model)
        </div>
        <div class="col-lg-8">
   
        <h3>تغيير كلمة المرور </h3> 
        <form asp-controller="Account" asp-action="ChangePassword" method="post">
          
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                        @ViewBag.SuccessMessage
                </div>
            }
            <div>
                <label class="label" for="OldPassword"><span>كلمة المرور القديمة</span></label>
                <input type="text" asp-for="OldPassword" class="form-control" id="AimsDD" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
                <div class="form-group">
                <label class="label" for="NewPassword"><span>كلمة المرور الجديد</span></label>

                    <div >
                    <input type="password" asp-for="NewPassword" class="form-control" id="AimsDD" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>
            <div class="form-group">
                <label class="label" for="ConfirmPassword"><span>تاكيد كلمة المرور الجديد</span></label>

                <div>
                    <input type="password" asp-for="ConfirmPassword" class="form-control" id="AimsDD" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
                @*<div class="form-group">

                        @Html.CheckBoxFor(m => m.RememberMe)
                        @Html.LabelFor(m => m.RememberMe)

                    </div>*@
                <div class="form-group">
                    <div >
                    <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">تغيير كلمة المرور</button>
                    </div>
                </div>

     </form>
    </div>
    <div class="clear"></div>
</div>
 
</div>

 
