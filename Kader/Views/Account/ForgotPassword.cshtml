 
 


@using Kader.DTOs.Users
@model ForgotPasswordDto
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
           
                <span class="breadcrumb-item active">نسيت كلمة المرور</span>
            </nav>
        </div>
    </div>
</div>
<div class="clear"></div>
<div class="container col-md-5">
   
        <h3>نسيت كلمة المرور </h3>
    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
          
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                        @ViewBag.SuccessMessage
                </div>
            }
            <div>
                <label class="label" for="OldPassword"><span>رقم التليفون</span></label>
                    <input type="text" asp-for="MobileNumber" class="form-control" id="AimsDD" />
                    <span asp-validation-for="MobileNumber" class="text-danger"></span>
            </div>
              
                <div class="form-group">
                    <div >
                    <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">تغيير كلمة المرور</button>
                    </div>
                </div>

     </form>
    </div>
    <div class="clear"></div>
 



 
