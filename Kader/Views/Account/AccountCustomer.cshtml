@model Kader.DTOs.Users.AllUserViewDto

@using Kader.Infrastructure.Shared;
@*  @if (Context.User.Identity.IsAuthenticated == false)
    {
         Context.Response.Redirect("/Login");
    } *@
@{
    ViewData["Title"] = "View";
}
@{
    Infrastructure.Shared.Interfaces.IKeys _keys = new Infrastructure.Shared.Implementations.Keys();
}
<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
                <a class="breadcrumb-item text-dark" href="#">حسابي  </a>
                <span class="breadcrumb-item active">الصفحة الشخصية</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<div class="container-fluid">
    <div class="row px-xl-5">
<div class="col-lg-3 col-md-4">
@Html.Partial("_sidebar", Model)
</div>
        <div class="col-lg-8">
        @if(Model!=null)
        {
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">معلومات الحساب</span></h5>
            <div class="bg-light p-30 mb-5">
                <h6 class="mb-3">بيانات الاتصال</h6> 
            <br />
                <div class="dir">
                 <span>  @Model.FirstName </span>
            
                <span> @Model.LastName</span>

                </div> <div>@Model.Email</div>
                <div>@Model.Username</div>
                </div>
    @if (Model.ActiveAddressDto != null)
    {
        <div class="bg-light p-30 mb-5">
            <h6 class="mb-3">سجل العناوين</h6> 
            @Html.ActionLink("اضافة وادارة العناوين", "AddAddress", null)
            <br /> 
            <h6 class="text-gray">  عنوان الشحن الافتراضي</h6>
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                <tr>
                      
                    <th>  المدينة</th>
                    <th>  الحي</th>
                    <th>العنوان</th>
                    <th>رقم المبني</th>
                    <th> الرقم الاضافي</th>
                        
                    <th>تليفون اخر</th>
                    <th>وقت التوصيل المناسب</th><th></th>
                                </tr>
                            </thead>
                            <tbody class="align-middle">
                <tr>
                                    <td class="align-middle">
                            @Model.ActiveAddressDto.City
                        </td>
                                    <td class="align-middle">
                            @Model.ActiveAddressDto.Name
                        </td>

                                    <td class="align-middle">@Model.ActiveAddressDto.AddressStreet</td>
                                    <td class="align-middle"> @Model.ActiveAddressDto.BuildingNo</td>
                                    <td class="align-middle">
                        @Model.ActiveAddressDto.BuildingNo1
                        </td>

                                    <td class="align-middle">
                        @Model.ActiveAddressDto.SecondryPhone
                        </td>
                                    <td class="align-middle">
                        @if (Model.ActiveAddressDto.ShiftDelivary == _keys.MorningShift())
                            {
                                <span>@_keys.MorningShiftText() </span>
                            }
                        else if (Model.ActiveAddressDto.ShiftDelivary == _keys.NightShift())
                            {
                                <span>@_keys.NightShiftText() </span>
                            }
                        </td>
                                    <td class="align-middle">
                        @Html.ActionLink("تعديل ", "AddAddress", new { AddressId = Model.ActiveAddressDto.AddressId }, null)
                    </td>
                </tr>

                            </tbody>
                        </table>
        </div>
       
    }
}

        </div>
    </div>
</div>
<div class="clear"></div>
</div></div>