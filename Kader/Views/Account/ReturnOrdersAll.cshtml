@model List<Kader.DTOs.ReturnOrders.AllReturnsOrdersDto>
@using Kader.Infrastructure.Shared;

@{
    ViewData["Title"] = "View";
}
@{
    Infrastructure.Shared.Interfaces.IKeys _keys = new Infrastructure.Shared.Implementations.Keys();
}
<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">الصفحة الرئيسية</a>
                <a class="breadcrumb-item text-dark" href="#">حسابي  </a>
                <span class="breadcrumb-item active">طلبات الارتجاع</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
            @Html.Partial("_sidebar", Model)
        </div>
        <div class="col-lg-8">



            @if (Model != null)
            {
                <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">طلبات الارتجاع </span></h5>
                <div class="bg-light p-30 mb-5">

                    <table class="table table-light table-borderless table-hover text-center mb-0">
                        <thead class="thead-dark" style="font-size:12px">
                            <tr>
                                <th>رقم الطلب</th>
                                <th>اسم المنتج</th>
                                <th>تاريخ تقديم ارتجاع العنصر</th>
                                <th>	إجمالي الطلب</th>
                                <th>الحاله</th>


                            </tr>
                        </thead>
                        <tbody class="align-middle">
                            @foreach (var item in Model)
                            { foreach (var item1 in item.ReturnsOrderItemslistDto)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            @item.Idorders
                                        </td>
                                        <td class="align-middle">
                                            @item1.ProductName
                                            @*  @{
                                var f = @item.TotalPrice + @item.TotalTransportShippPrice;
                                }
                                @f *@
                                        </td>
                                        <td class="align-middle"> @item.InsertDate</td>


                                        <td class="align-middle">
                                            @item1.Quantity
                                        </td>



                                        <td class="align-middle">

                                            @item.Status
                                            @if (item.Address!=null)
                                            {
                                              <span>علي العنوان </span>  @item.Address
                                            }
                                            
                                         </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            }
        </div>
    </div>
</div>
<div class="clear"></div>