            $('#treeview1').jstree({
                plugins: ['search', 'wholerow'],
                core: {

                    data: {
                        url: function (node) {
                            return node.id === '#' ? '../product/GetRoot_qta3a' : '../product/GetChildren_qta3a/' + node.id;
                        },
