$(document).ready(function () {
    $.ajax({
        url: '@Url.Action("GetRoot", "Home")',
        method: 'GET',
        success: function (data) {
            var menuHtml = generateMenu(data);
            $('#menu').html(menuHtml);
                        var menuHtml1 = generateMenu1(data);
                        $('#menu1').html(menuHtml1);
        }
    });

    function generateMenu(nodes) {
        var html = '<ul>'; 
        html += '<li class="menu-item"><a href="@Url.Content("~/Gomla/Index/")">كل المنتجات</a></li>';
         
        nodes.forEach(function (node) {
            var url = '@Url.Content("~/Gomla/Index/")' + node.id;
                        html += '<li class="menu-item" data-id="' + node.id + '"><a href="' + url + '">' + node.name + '</a>';
            if (node.Children) {
                html += '<ul class="submenu" id="submenu-' + node.id + '"></ul>';
            }
            html += '</li>';
        });
        // Add the "all" link at the end of the menu
 
        html += '</ul>';
        return html;
    }
                function generateMenu1(nodes) {
                    var html = '<ul>';
                    html += '<li class="menu-item"><a href="@Url.Content("~/Qt3/Index/")">كل المنتجات</a></li>';

                    nodes.forEach(function (node) {
                        var url = '@Url.Content("~/Qt3/Index/")' + node.id;
                        html += '<li class="menu-item" data-id="' + node.id + '"><a href="' + url + '">' + node.name + '</a>';
                        if (node.Children) {
                            html += '<ul class="submenu" id="submenu-' + node.id + '"></ul>';
                        }
                        html += '</li>';
                    });
                    // Add the "all" link at the end of the menu

                    html += '</ul>';
                    return html;
                }
    // Event delegation to handle click events on dynamically generated elements
    $(document).on('click', '#menu li > a', function (e) {
        if ($(this).siblings('.submenu').length > 0) {
            e.preventDefault(); // Prevent the default action (navigation) only if there is a submenu
            $(this).siblings('.submenu').toggle(); // Toggle the visibility of the submenu
        }
    });

    $('#menu-trigger').on('click', function () {
        $('#menu').toggle(); // Toggle the visibility of the menu
         $('#menu1').hide(); // Hide the other menu
    });
});

