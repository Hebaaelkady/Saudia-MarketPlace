 
@{
 
    Layout = "~/Views/Shared/_Layout.cshtml";
}@{
    ViewData["Title"] = "فشل العملية";
}

<div class="container">
    <h1>فشل العملية</h1>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.
        </div>
    }
    <a href="/Cart/ViewCart" class="btn btn-primary">العودة إلى السلة</a>
</div>
 <div>حدث خطا اثناء الحفظ</div>