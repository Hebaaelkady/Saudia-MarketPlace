<script>
    // Define the redirection time in milliseconds (5 minutes = 300,000 ms)
    const inactivityTimeout = 6000000000; // 5 minutes

    // URL to redirect to after inactivity
    const redirectUrl = '/Cart/ViewCart'; // Replace with the desired redirect URL

    // Timer variable
    let inactivityTimer;

    // Function to reset the inactivity timer
    function resetInactivityTimer() {
        clearTimeout(inactivityTimer); // Clear the existing timer
        inactivityTimer = setTimeout(() => {
            //alert('تمت إعادتك إلى الصفحة السابقة بسبب عدم النشاط.');
            window.location.href = redirectUrl; // Redirect to the specified URL
        }, inactivityTimeout); // Start a new timer
    }

    // List of events to track user activity
    const activityEvents = ['mousemove', 'keydown', 'mousedown', 'touchstart'];

    // Attach event listeners to reset the timer on user activity
    activityEvents.forEach(event => {
        window.addEventListener(event, resetInactivityTimer);
    });

    // Initialize the inactivity timer when the page loads
    @* resetInactivityTimer(); *@
</script>

