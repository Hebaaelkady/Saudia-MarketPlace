                    },
                    body: JSON.stringify(combinedDto),
                    timeout: 30000
                });

                let result = await response.json();
                console.log('✅ SavePayment Response:', result);

                if (result.isSuccess) {
                    setTimeout(() => {
                        window.location.href = '/OrderDetails/' + result.orderId;
                    }, 5000);
                    resolve(result);  // ✅ نجاح العملية
                } else {
                    console.log('❌ SavePayment failed:', result.message);
