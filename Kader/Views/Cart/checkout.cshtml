    function deleteCookie(name) {
        document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
    }

    function parseQueryString(queryString) {
    let obj = {};
    let params = new URLSearchParams(queryString);

    params.forEach((value, key) => {
        // Check if the key contains array notation like Itemslist[0].ProductId
        let match = key.match(/(\w+)\[(\d+)\]\.(\w+)/);
        if (match) {
            let [, arrayKey, index, propKey] = match;

            // Initialize the array and the object at the given index if not already present
            obj[arrayKey] = obj[arrayKey] || [];
            obj[arrayKey][index] = obj[arrayKey][index] || {};

            // Set the property value
            obj[arrayKey][index][propKey] = value;
        } else {
            // Otherwise, just set the property on the root object
            obj[key] = value;
        }
    });

    return obj;
}

 
