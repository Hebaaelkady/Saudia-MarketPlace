                        window.location.href = '/Cart/ViewCart';
                    }, 5000);
                    reject(new Error(result.message));  // ❌ فشل العملية
                }
            } catch (error) {
                console.error('⚠️ AJAX Error:', error);
                setTimeout(() => {
                    window.location.href = '/Cart/ViewCart/?error=' + encodeURIComponent(error.message);
                }, 500);
                reject(error);  // ❌ رفض `Promise` بسبب خطأ
            }
        });
    }
});

