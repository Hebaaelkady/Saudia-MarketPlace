<!-- Carousel Start -->
<div class="container-fluid mb-3">
    <div class="row px-xl-5">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel" data-interval="2000">
                @{
                    int i = 0;
                }
               
                <ol class="carousel-indicators">
                    @foreach (var item1 in Model.BannerImgsDto)
                    {
                        <li data-target="#header-carousel" data-slide-to="@i"
                            class="@(item1 == Model.BannerImgsDto.First() ? "active" : "")"></li>
                        i++;
                    }
                </ol>

                <div class="carousel-inner">
                    @foreach (var item in Model.BannerImgsDto)
                    {
                        <div class="carousel-item position-relative @(item == Model.BannerImgsDto.First() ? "active" : "")" style="height: 430px;">
                            <img class="position-absolute w-100 h-100" src="../Images/@Url.Content(item.BannerImgName)" alt="@item.BannerImgName" style="object-fit: cover;">
                        </div>
                    }
                </div>

                <!-- Optional navigation controls -->
                <a class="carousel-control-prev" href="#header-carousel" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#header-carousel" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="product-offer mb-30" style="height: 200px;">
                @if (!string.IsNullOrEmpty(Model.AdsDto.AdName1))
                {
                    <img class="img-fluid" src="@Url.Content($"~/Images/{Model.AdsDto.AdName1}")" alt="Latest Ad 1">
                }

@* 
                <img  class="img-fluid" src="~/online-shop/2018_11_6_21_33_39_808.jpg" /> *@
 
                <div class="offer-text">
                 @*    <h6 class="text-white text-uppercase">وفر 20%  </h6> *@
                    <h3 class="text-white mb-3">عرض خاص</h3>
                    <a href="" class="btn btn-primary">تسوق الان</a>
                </div>
            </div>
            <div class="product-offer mb-30" style="height: 200px;">
               @*  <img class="img-fluid" src="~/online-shop/بوستر-اعلان-قهوة-1-768x768.jpg" /> *@
                @if (!string.IsNullOrEmpty(Model.AdsDto.AdName2))
                {
                    <img class="img-fluid" src="@Url.Content($"~/Images/{Model.AdsDto.AdName2}")" alt="Latest Ad 1">
                }
                <div class="offer-text">
                  @*   <h6 class="text-white text-uppercase">وفر 20%</h6> *@
