                    <script>
    $(document).ready(function () {
        $.ajax({
            url: '../Gomla/GetRoot_gomla',
            method: 'GET',
            success: function (data) {
                var menuHtml = generateMenu(data);
                $('#menu').html(menuHtml);
            }
        });

        function generateMenu(nodes) {
            var html = '<ul>';
            nodes.forEach(function (node) {
                html += '<li class="menu-item" data-id="' + node.Id + '"><a href="/category/' + node.Id + '">' + node.Text + '</a>';
                if (node.Children) {
                    html += '<ul class="submenu" id="submenu-' + node.Id + '"></ul>';
                }
                html += '</li>';
            });
            html += '</ul>';
            return html;
        }

    });

                    </script>