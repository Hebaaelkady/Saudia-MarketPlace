{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.Hosting.Lifetime": "Error"
    }
  },
  "Urls": "http://localhost:7000;https://localhost:7001",
  "AllowedHosts": "*",
  "EnableWebSockets": true,
  "ConnectionStrings": {
    "seSelocs": "Server=YOUR_SERVER_IP;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Database=YOUR_DB_NAME;Connection Timeout=100;"
  },
  "Keys": {
    "signingKey": "YOUR_SIGNING_KEY_MINIMUM_32_CHARACTERS"
  },
  "OtoApi": {
    "RefreshToken": "YOUR_OTO_API_REFRESH_TOKEN"
  }
}
