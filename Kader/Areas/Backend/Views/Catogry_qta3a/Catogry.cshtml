 
@model  Kader.DTOs.Catogry.Catogry_backendDto 
 
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/BackEnd/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <nav aria-label="Breadcrumb">
    <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>الفئات الرئيسية (قطاعي (</span>
    </nav>
</div>
<fieldset>
    <legend>
        <h2 class="text-dark font-weight-bold mt-2 mb-2 mr-5 din-bold d-inline">
            @if (string.IsNullOrEmpty(Context.Request.Query["Id"]))
            {
                <span>اضافة فئة قطاعي جديد</span>
            }
            else
            {
                <span>تعديل فئة قطاعي جديد</span>
            }
        </h2>
    </legend>
@Html.Partial("_Catogry", Model)
</fieldset>
<fieldset>
    <legend><h2>الفئات الرئيسية (قطاعي (</h2></legend>
<div class="page-section">
    <div class="container">
        
        <table id="myTable" border="1" class="display table table-separate table-head-custom table-foot-custom">
            <thead>
                <tr>
                        <th>الفئات القطاعي الرئيسية</th>
                        <th>حذف </th>
                       
                        <th>تعديل </th>
                        
                </tr>
            </thead>
            <tbody>
                    @if (Model.ExistingItems != null)
            {
                foreach (var item in Model.ExistingItems)
                {
                    
                     string word = item.CatogryName; // Replace with your actual model property
                        if (word.EndsWith("-قطاعي"))
                        {
                        word = word.Substring(0, word.Length - "-قطاعي".Length);
                        }
                    
                    <tr>
                        <td>
                                    @word
                        </td>
                                <td>   <input type="button" value="حذف الفئة" class="Delete btn2 btn-default" data-val="@item.CatogryId" data2="@item.RoleId" /></td>
                                <td>    @Html.ActionLink("تعديل", "Catogry", new { CatogryId = item.CatogryId }, null) </td>

                    </tr>
                }
            }
           </tbody>
        </table>

    </div>
</div>
</fieldset>

<script>
    $(".btn2").on("click", function () {
        if (confirm("هل انت متاكد من الحذف")) {
            var requrl = "/Backend/Catogry_qta3a/DeleteCat";

            $.ajax({
                type: "post",
                dataType: 'json',
               // cashe: true,
                url: requrl,
                data: { id: $(this).attr('data-val'), RoleId: $(this).attr('data2') },
                success: function (json) {
                    console.log(json);
                    alert(JSON.stringify(json));
                    location.reload();
                },
              
                    error: function (xhr, status, error) {
                        console.log("XHR Response: " + xhr.responseText);
                        console.log("Status: " + status);
                        console.log("Error: " + error);
                        alert("حدث خطأ: " + xhr.responseText);
                    }
                
            });
        } else {
            // User clicked Cancel
            // Handle accordingly
        }


    });

</script>


