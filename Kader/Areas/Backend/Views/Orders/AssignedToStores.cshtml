@model List<Kader.DTOs.Orderss.OrderBackendDto>
@using Kader.Infrastructure.Shared;
@using Kader.Infrastructure.Shared.Implementations
@using Kader.Infrastructure.Shared.Interfaces

@{
    ViewData["Title"] = "View";
}
@{
    IKeys _keys = new Keys();
}<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
@* <button id="enableNotifications">تفعيل الإشعارات</button> *@
<script>
    document.getElementById("enableNotifications").addEventListener("click", function () {
        Notification.requestPermission().then(permission => {
            if (permission === "granted") {
                alert("تم تفعيل الإشعارات بنجاح!");
                initializeSignalR(); // ✅ ابدأ SignalR بعد الموافقة على الإشعارات
            } else {
                alert("يجب السماح بالإشعارات لتلقي الإخطارات.");
            }
        });
    });

    // ✅ جلب معرف المستخدم وأدواره
    var userId = "@User.Claims.FirstOrDefault(c => c.Type == "Id")?.Value";
    var userRoles = @Html.Raw(Json.Serialize(User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value) ?? new List<string>()));


    if (userId) {
        // ✅ إنشاء اتصال SignalR
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/OrderHub")
            .build();

        // ✅ بدء الاتصال
        connection.start().then(() => {
            console.log("✅ SignalR Connected");
            return connection.invoke("JoinOrdersPage", userId, userRoles);
        }).catch(err => console.error("❌ SignalR Connection Error:", err));

        // ✅ استقبال الإشعار عند إضافة طلب جديد
        connection.on("ReceiveNewOrderNotification", function () {
            if (Notification.permission === "granted") {
                let notification = new Notification("🚀 طلب جديد!", {
                    body: "تم استلام طلب مخصص لمخزنكم جديد. اضغط لعرض التفاصيل.",
                    icon: "/images/order-icon.png"
                });

                notification.onclick = function () {
                    window.location.href = "/Backend/Orders/NewOrders"; // ✅ تأكد من صحة المسار
                };
            } else {
                alert("🔔 طلب جديد وصل! انتقل إلى صفحة الطلبات الجديدة.");
            }
        });

        // ✅ تسجيل خروج المستخدم عند مغادرة الصفحة
        window.addEventListener("beforeunload", function () {
            connection.invoke("LeaveOrdersPage", userId)
                .catch(err => console.error("⚠️ Error leaving SignalR:", err));
        });

        // ✅ طلب إذن الإشعارات
        if (Notification.permission !== "granted") {
            Notification.requestPermission();
        }
    } else {
        console.warn("⚠️ المستخدم غير مسجل دخوله، لن يتم الاتصال بـ SignalR.");
    }
</script>
<div class="container">
    <nav aria-label="Breadcrumb">
        <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>طلبات جديدة مخصصة لمخزن</span>
    </nav>
</div>
<fieldset>
    <legend><h2> طلبات جديدة مخصصة لمخزن </h2></legend>
    <div class="page-section">
        <div class="container">
            @if (Model != null)
            {
                <div class="box">
                    <br />
                    <table id="myTable" width="100%" border="1" class="display table table-5 separate table-head-custom table-foot-custom">
                      <thead>  <tr>
                            <th>رقم الطلب</th>
                            <th>التاريخ</th>
                            <th>عدد المنتجات</th>
                            <th>إجمالي المبلغ</th>

                       @*      <th>الحاله</th> *@
                            <th>إجراء</th>

                            </tr>
                        </thead><tbody>
                        @foreach (var item in Model.OrderByDescending(g => g.InsertDate))
                        {
                            <tr>
                                <td>
                                    @item.Idorders
                                </td>
                                <td> @item.InsertDate</td>
                                <td>
                                    @if (@item.Itemslist != null)
                                    {
                                        @item.Itemslist.Count()
                                    }
                                </td>
                                <td>
                                    @{
                                        var f = @item.TotalPrice + @item.TotalTransportShippPrice;
                                    }
                                        @f <span>ريال سعودي</span>
                                </td>
                             @*    <td> @item.status</td> *@
                                
                                <td>
                                    @Html.ActionLink("تفاصيل", "OrderDetails", new { id = item.OrderPayment }, null)
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <div class="clearfix"></div>
                </div> <div class="clearfix"></div>
            } <div class="clearfix"></div>
        </div> <div class="clearfix"></div>
        <div class="clearfix"></div>
    </div>
    <div class="clearfix"></div>

</fieldset>
