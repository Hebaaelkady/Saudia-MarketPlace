@if (Model != null && Model.StatusId == _keys.AssignedToInsideShipping())
{

<script>

    $("#CheckCode").click(function () {
        var orderIds = $("#orderId").val();
        var Code = $("#Code").val();

        $.ajax({
            url: '@Url.Action("CheckCode", "Orders")',
            type: 'POST',
            data: { orderIds: orderIds, Code: Code },
            success: function (response) {
                if (response && response.success) {
                    alert(response.message);

                    // ✅ Show "Accept" radio button if check is true
                    $("#Acceptdiv").show();
                } else {
                    alert(response.message || "حدث خطأ غير متوقع، لم يتم استلام رسالة من السيرفر.");

                    // ✅ Hide both radio buttons
                    $("#Acceptdiv").hide();
                }
            },
            error: function () {
                alert("حدث خطأ أثناء التحقق من الكود.");
            }
        });
    });

    $("#saveInnerDeliveryBtn").click(function () {
        var deliverStatus = $('input[name="deliver"]:checked').val(); // Get selected value

        // ✅ Ensure a radio button is selected
        if (!deliverStatus) {
            alert("الرجاء تحديد حالة التسليم (تم التسليم أو لم يتم التسليم).");
            return;
        }

        var orderIds = $("#orderId").val();
        var Comment = $("#Comment").val();
        var Code = $("#Code").val();

        $.ajax({
            url: '@Url.Action("saveInnerDeliveryBtn", "Orders")',
            type: 'POST',
            data: { orderIds: orderIds, deliverStatus: deliverStatus, Comment: Comment, Code: Code },
            success: function (response) {
                if (response && response.message) {
                    alert(response.message);
                    if (response.success) {
                        location.reload();
                    }
                } else {
                    alert("حدث خطأ غير متوقع، لم يتم استلام رسالة من السيرفر.");
                }
            },
            error: function () {
                alert("حدث خطأ أثناء حفظ الطلب.");
            }
        });
    });

    // ✅ Hide radio buttons on page load
    $("#Acceptdiv").hide();

</script>
}
    <script>
    var isAdmin = @Html.Raw(isAdminJson);
    $(document).ready(function () { 
        if (isAdmin.includes(2)) {
            var shippingUsersData = @Html.Raw(Json.Serialize(ViewBag.ShippingUsersByStore));

            var usersDropdown = $("#ShippingUsersDropdown");
            usersDropdown.empty().append('<option value="">اختر المستخدم</option>');

            if (shippingUsersData && Object.keys(shippingUsersData).length > 0) {
                var firstStoreKey = Object.keys(shippingUsersData)[0]; // Get the first store key
                var users = shippingUsersData[firstStoreKey];

                $.each(users, function (index, user) {
                    var textParts = user.text.split('-'); // JavaScript uses lowercase 'split'
                    var phone = textParts.length > 1 ? textParts[1].trim() : ''; // Ensure no errors

                    usersDropdown.append('<option value="' + user.value + '" data-phone="' + phone + '">' + user.text + '</option>');
                });
            }
        }
    });


    $(document).ready(function () {
        $("#StoreId1").change(function () {
            var storeId = $(this).val();
        
            if (storeId) {
                $.ajax({
                    url: '@Url.Action("GetUsersByStore", "Orders")',
                    type: "GET",
                    data: { storeId: storeId }, // Passing storeId as a query parameter
                    success: function (data) {
                        var usersDropdown = $("#ShippingUsersDropdown");
                        usersDropdown.empty();
                        usersDropdown.append('<option value="">اختر المستخدم</option>');
                       
                        $.each(data, function (index, user) {
                            usersDropdown.append('<option value="' + user.id + '"  data-phone="' + user.countryCode + user.phoneNumber + '">' + user.fullName + ' - ' + user.phoneNumber + '</option>');
                        });
                    }
                });
            } else {
                $("#ShippingUsersDropdown").empty().append('<option value="">اختر المستخدم</option>');
            }
        });
