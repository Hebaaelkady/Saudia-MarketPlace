    async function checkOTODeliveryFee() {
        // Get inputs
        const originCityCode = $("#pickupLocationsDropdown option:selected").attr("data1");
        const destinationCity = $("#destinationCity").val();
        const weightInput = $("#weight").val(); 
        // Validate inputs
        if (!originCityCode) {
            alert("من فضلك قم باختيار المخزن.");
            return; // Stop further execution
        }
        if (!destinationCity) {
            alert("المدينة او العنوان غير صحيح."); // Alert if destinationCity is missing
            return; // Stop further execution
        }
        if (!weightInput || isNaN(weightInput) || parseFloat(weightInput) <= 0) {
            alert("من فضلك ادخل وزن الشحنة");
            return; // Stop further execution
        }

        // Prepare request payload
        const request = {
            originCity: originCityCode,
            destinationCity: destinationCity,
            weight: parseFloat(weightInput),
        };

        try {
            // Make API call
            const response = await fetch("/Backend/Orders/CheckOTODeliveryFee", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(request),
            });
             
            const data = await response.json();

            if (response.ok && data.success && data.deliveryCompany.length > 0) {
                let resultHtml = `<h3>الشركات المتاحة:</h3><form id="deliveryOptionsForm"><table class=table border=1 width=100%><tr><th></th><th>اسم الشركة</th><th>السعر</th><th>وقت الاستلام</th><th>اكبر كمية شحن مجانية</th><th>متوسط ​​وقت التسليم</th><th>رسوم الإرجاع</th></tr>`;
                data.deliveryCompany.forEach((company, index) => {
                    resultHtml += `
                            <tr>
                                <td><input type="radio" name="selectedDelivery" id="deliveryOption-${index}" value="${company.deliveryOptionId}"></td>
                                <td for="deliveryOption-${index}">
                                    <strong>${company.deliveryCompanyName}</strong>
                                </td>
                                <td>${company.price}</td>
                                <td>${company.pickupCutOffTime}</td>
                                <td>${company.maxFreeWeight}kg</td>
                                    <td style= direction: ltr;>${company.avgDeliveryTime}</td>
                                <td>${company.returnFee}</td>
                            </tr>
                        `;
                });
                resultHtml += `</table></form>`;
               
                document.getElementById("otoFeeResult").innerHTML = resultHtml;
                if ($("#shipmentResult #btn").length === 0) {
                    $("#shipmentResult").append(
                        '<button type="button" id="btn" onclick="submitDeliveryOption()">ارسال الشحنة</button>'
                    );
                }
            } else {
                document.getElementById("otoFeeResult").innerHTML = `
                    <p>Error: ${data.errorMessage || "لايوجد شركات شحن متاحة"}</p>
                `;
            }
        } catch (error) {
            // Handle exceptions
            // console.error("Error checking OTO delivery fee:", error);
            document.getElementById("otoFeeResult").innerHTML = `
                <p>حدث خطا</p>
            `;
        }
    }


    function submitDeliveryOption() {
        
        const $form = $("#processShipmentForm");
        const formData = new FormData($form[0]);
        var itemsData = [];
       
        $(".table-items tr").not(":first").each(function () {
     
            var productId = $(this).data("product-id");
            var price = parseFloat($(this).find(`.price-${productId}`).val()) + parseFloat($(this).find(`.ShippingPrice-${productId}`).val());
            var name = $(this).find(`.SubCatogryTitle-${productId}`).val();
            
            var sku = $(this).find(`.sku-${productId}`).val();
            var quantity = parseFloat($(this).find(`.quantity-${productId}`).val());
            var rowTotal1 = parseFloat(price * quantity);
            if (!isNaN(price) && !isNaN(quantity)) {
                itemsData.push({
                    productId: productId,
                    name: name,
                    price: price,
                    quantity: quantity,
                    rowTotal: rowTotal1,
                    sku: sku
                });
            }
        });
        const customer = {} ;

        const row = $(".CusomerInfo tr").eq(1);
            const address = row.find("td").eq(2).text().trim() + "رقم المبني" + row.find("td").eq(3).text().trim();
             
            customer.name= $("#CustomerName").text().trim(),
            customer.mobile = $("#mobile").text().trim(),
            customer.city = row.find("td").eq(0).text().trim(),
            customer.district = row.find("td").eq(1).text().trim(),
            customer.address = address,
            customer.secondaryPhone = row.find("td").eq(4).text().trim(),
            customer.deliveryTime = row.find("td").eq(5).text().trim(),
            customer.country = "SA"
        const latText = row.find("td").eq(6).text().trim();
        const lonText = row.find("td").eq(7).text().trim();

         
        const lat = latText ? parseFloat(latText) : null;
        const lon = lonText ? parseFloat(lonText) : null;

        if (!isNaN(lat) && !isNaN(lon)) {
            customer.lat = lat;
            customer.lon = lon;
        }
      
        const selectedRadio = document.querySelector('input[name="selectedDelivery"]:checked');
        if (!selectedRadio) {
            alert("من فضلك اختار شركة الشحن");
            return;
        }
        //الشركة اللي هتنقل واللي متعاقد معاها
        const deliveryOptionId = selectedRadio.value;
        //المخزن اللي هتاخد منه
        const pickupLocationCode = $("#pickupLocationsDropdown option:selected").val();
        if (!pickupLocationCode) {
            alert("من فضلك اختار المخزن");
            return;
        }
        var amount = parseFloat($("#amount").val()) || 0; // تعيين 0 إذا كانت القيمة غير صالحة
        var shippingAmount = parseFloat($("#shippingAmount").val()) || 0; // تعيين 0 إذا كانت null أو غير صالحة
        var subtotal = amount + shippingAmount; // الحساب

     

        // Collect Order Data
        const createOrderDto = {
            orderId: $("#orderId").val(),
            payment_method: "paid",
            senderName:"Jina market",
            amount: amount,  
            shippingAmount: shippingAmount,
            subtotal: subtotal,
            amount_due:  0 ,
            currency: "SAR",  
            pickupLocationCode: pickupLocationCode,
            deliveryOptionId: deliveryOptionId,
            orderDate: $("#orderDate").val(),
            createShipment:true,
            customer: customer,
            items: itemsData,
        };
        if (createOrderDto != null) {
            $.ajax({
                url: "/Backend/orders/ProcessShipment",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(createOrderDto),
                success: function (result) {
                // <pre>${JSON.stringify(result.orderResponse, null, 2)}</pre>
                    if (result && result.orderResponse) {
                        $("#shipmentResult").html(`
                    <h3 style="color: green;">تم عمل طلبية الشحن بنجاح.</h3>
                    
                    `); setTimeout(function () {
                            location.reload();
                        }, 2000);
                    }
                    else if(result)
                    {$("#shipmentResult").html(result.message); setTimeout(function () {
                            location.reload();
                        }, 2000);

                    }
                    else {
                        $("#shipmentResult").html(`
                    <p style="color: orange;">يوجد مشكلة اثناء عملية الشحن</p>
                `);
                    }
                },
                error: function (xhr, status, error) {
               
                    const errorMessage = "حدث خطا";
                    $("#shipmentResult").html(`
                <p style="color: red;">  ${errorMessage}</p>
            `);
                     
                },
            });
        } else {
            alert("من فضلك اختار البيانات اولا");
        }
    }
 
    async function loadPickupLocations() {
      
     
          try {
   
    const response = await fetch("/Backend/orders/GetPickupLocations");
            const data = await response.json();

            if (response.ok) {
                const dropdown = document.getElementById("pickupLocationsDropdown");
                dropdown.innerHTML = '<option value="">اختار المخزن</option>';

                const locations = [...data.warehouses, ...data.branches];
                locations.forEach((location) => {
                    const option = document.createElement("option");
                    option.value = location.code;
                    option.setAttribute("data1", location.city);
                    option.textContent = `${location.name} - ${location.city}`;
                    dropdown.appendChild(option);
                });
            } else {
                console.error("Error:", data.error);
            }
        }
        catch (error)
        {
            console.error("Error fetching pickup locations:", error);
        }
    }
        
     

