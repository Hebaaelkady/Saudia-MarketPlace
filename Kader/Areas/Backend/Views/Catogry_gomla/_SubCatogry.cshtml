@model Kader.DTOs.Catogry.Catogry_backendDto
<form asp-controller="Catogry_gomla" asp-action="AddCatogry" method="post">

    <div class="form-group">
        <label> الصنف</label>
        @Html.DropDownList("CatId", null, htmlAttributes: new { @class = "form-control" })
       @*  @Html.ValidationMessageFor(model => model.CatogryName) *@

    </div>


    <div class="form-group">
        <label>اسم فئة الفرعي</label>

        <input type="hidden" asp-for="CatLevel" name="CatLevel" class="form-control" value="2" />
        <input type="text" asp-for="CatogryName" name="CatogryName" class="form-control" />
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit">حفظ فئة</button>
        </div>
    </div>

</form>