<fieldset>
    <legend><h2>المستخدمين</h2></legend>
    <div class="page-section">
        <div class="container">
            <table id="myTable" border="1" class="display table table-separate table-head-custom table-foot-custom">
                <thead>
                    <tr>
                        <th>اسم الاول والاخير</th>
                        <th>رقم التليفون</th>
                        <th>اسم المستخدم</th>
                        <th>الصلاحيات</th>
                        <th>مخازن مسئول </th>
                        <th></th>
                        <th>حذف</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FirstName @item.LastName </td>
                                <td style="direction: ltr;">@item.CountryCode @item.PhoneNumber</td>
                                <td>@item.Username</td>
                                <td>
                                    @foreach (var role in item.Roles)
                                    {
                                        <span>@role</span>
                                        <br />
                                    }
                                </td>

                                <!-- 🏪 مخازن مسئول مخزن -->
                                <td>
                                    @if (item.UsersStoresDto != null )
                                    {
                                        @foreach (var store in item.UsersStoresDto)
                                        {
                                            <span>@store.StoreName</span>
                                            <br />
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span> <!-- لا يوجد مخازن لهذا المستخدم -->
                                    }
                                </td>

                                <td>
                                    @Html.ActionLink("تعديل", "EditUser", new { userId = item.Id }, null)
                                </td>

                                <td>
                                    <input type="button" value="حذف المستخدم" class="Delete btn2 btn-default" data-val="@item.Id" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</fieldset>



<script>
    $(".btn2").on("click", function () {
        if (confirm("هل انت متاكد من الحذف")) {
            var requrl = "/Backend/Account/DeleteUser";

            $.ajax({
                type: "post",
                dataType: 'json',
                // cashe: true,
                url: requrl,
                data: { id: $(this).attr('data-val') },
                success: function (json) {
                    console.log(json);
                    alert(JSON.stringify(json));
                    location.reload();
                },

                error: function (xhr, status, error) {
                    console.log("XHR Response: " + xhr.responseText);
                    console.log("Status: " + status);
                    console.log("Error: " + error);
                    alert("حدث خطأ: " + xhr.responseText);
                }

            });
        } else {
            // User clicked Cancel
            // Handle accordingly
        }


    });

    document.addEventListener("DOMContentLoaded", function () {
        var InsideShippingRole = document.getElementById("InsideShippingRole");
        var storeCheckbox = document.getElementById("IsStore");
        var shippingCheckbox = document.getElementById("ShippingRole");
        var storeOptions = document.getElementById("store-options");

        function toggleVisibility() {
            if (storeCheckbox.checked || InsideShippingRole.checked || shippingCheckbox.checked) {
                storeOptions.style.display = "block";
            } else {
                storeOptions.style.display = "none";
                storeOptions.querySelectorAll("input[type='checkbox']").forEach(cb => cb.checked = false);
            }
        }
        InsideShippingRole.addEventListener("change", toggleVisibility);
        storeCheckbox.addEventListener("change", toggleVisibility);
        shippingCheckbox.addEventListener("change", toggleVisibility);

        // Restore selected roles on page load
        let selectedRoles = @Html.Raw(Json.Serialize(ViewBag.SelectedRoles ?? new List<string>()));
        selectedRoles.forEach(role => {
            let checkbox = document.querySelector(`input[name='Roles'][value='${role}']`);
            if (checkbox) {
                checkbox.checked = true;
            }
        });

        // Ensure store options are visible if needed
        toggleVisibility();
    });

    document.addEventListener("DOMContentLoaded", function () {
        let savedCountryCode = localStorage.getItem("selectedCountryCode");
        if (savedCountryCode) {
            document.getElementById("countryCode").value = savedCountryCode;
        }

        document.getElementById("countryCode").addEventListener("change", function () {
            localStorage.setItem("selectedCountryCode", this.value);
        });
    });

</script>
