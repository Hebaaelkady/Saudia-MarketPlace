 
 


@using Kader.DTOs.Users
@model LoginDto

@{
    ViewBag.Title = "Create";
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
	<title>Login V4</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1"> 
	<!--===============================================================================================-->
    
    <link href="~/assets/css/bootstrap/css/bootstrap.min.css" rel="stylesheet" /> 
    <link href="~/assets/css/fonts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" /> 
    <link href="~/assets/css/fonts/iconic/css/material-design-iconic-font.min.css" rel="stylesheet" />
    <link href="~/assets/css/animate/animate.css" rel="stylesheet" />
    <link href="~/assets/css/util.css" rel="stylesheet" />
    <link href="~/assets/css/main.css" rel="stylesheet" /> 
	<!--===============================================================================================-->
</head>
<body>

	<div class="limiter">
        <div class="container-login100" >
			<div class="wrap-login100 p-l-55 p-r-55 p-t-65 p-b-54">

				<form class="login100-form validate-form" asp-controller="Backend/Account" asp-action="Login" method="post">
					<span class="login100-form-title p-b-49">
						تسجيل الدخول
					</span>

					<div class="wrap-input100 validate-input m-b-23" data-validate="اسم المستخدم مطلوب">
						<span class="label-input100">اسم المستخدم</span>

						<input type="text" asp-for="userName" name="userName" class="input100" placeholder="اسم المستخدم مطلوب" />
						 
						<span class="focus-input100" data-symbol="&#xf206;"></span>
					</div>

					<div class="wrap-input100 validate-input" data-validate="كلمة السر مطلوبة">
						<span class="label-input100">كلمة السر</span>

						<input type="password" asp-for="Userpass" name="Userpass" class="input100" placeholder="كلمة السر مطلوبة" />
					 
						<span class="focus-input100" data-symbol="&#xf190;"></span>
					</div>

					 
					<br />	<br />
					<div class="container-login100-form-btn">
						<div class="wrap-login100-form-btn">
							<div class="login100-form-bgbtn"></div>
							<button class="login100-form-btn" type="submit">
								تسجيل الدخول
							</button>
						</div>
					</div>

					 
 
				</form>
			</div>
		</div>
	</div>




</body>
</html>
 