<script>
    async function checkOTODeliveryFee() {
        // Get inputs
        const destinationCity = $("#pickupLocationsDropdown option:selected").attr("data1");
        const originCityCode = $("#destinationCity").val();
        const weightInput = $("#weight").val();

        // Validate inputs
        if (!originCityCode) {
            alert("من فضلك قم باختيار المخزن.");
            return; // Stop further execution
        }
        if (!destinationCity) {
            alert("المدينة او العنوان غير صحيح."); // Alert if destinationCity is missing
            return; // Stop further execution
        }
        if (!weightInput || isNaN(weightInput) || parseFloat(weightInput) <= 0) {
            alert("من فضلك ادخل وزن الشحنة");
            return; // Stop further execution
        }

        // Prepare request payload
        const request = {
            originCity: originCityCode,
            destinationCity: destinationCity,
            weight: parseFloat(weightInput),
        };

        try {
            // Make API call
            const response = await fetch("/Backend/Orders/CheckOTODeliveryFee", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(request),
            });
             
            const data = await response.json();

            if (response.ok && data.success && data.deliveryCompany.length > 0) {
                let resultHtml = `<h3>الشركات المتاحة:</h3><form id="deliveryOptionsForm"><table class=table border=1 width=100%><tr><th></th><th>اسم الشركة</th><th>السعر</th><th>وقت الاستلام</th><th>اكبر كمية شحن مجانية</th><th>متوسط ​​وقت التسليم</th><th>رسوم الإرجاع</th></tr>`;
                data.deliveryCompany.forEach((company, index) => {
                    resultHtml += `
                            <tr>
                                <td><input type="radio" name="selectedDelivery" id="deliveryOption-${index}" value="${company.deliveryOptionId}"></td>
                                <td for="deliveryOption-${index}">
                                    <strong>${company.deliveryCompanyName}</strong>
                                </td>
                                <td>${company.price}</td>
                                <td>${company.pickupCutOffTime}</td>
                                <td>${company.maxFreeWeight}kg</td>
                                    <td style= direction: ltr;>${company.avgDeliveryTime}</td>
                                <td>${company.returnFee}</td>
                            </tr>
                        `;
                });
                resultHtml += `</table></form>`;
                document.getElementById("otoFeeResult").innerHTML = resultHtml;
                if ($("#processShipmentForm #btn").length === 0) {
                    $("#processShipmentForm").append(
                        '<button type="button" id="btn" onclick="submitDeliveryOption()">ارسال الشحنة</button>'
                    );
                }
            } else {
                document.getElementById("otoFeeResult").innerHTML = `
                    <p>Error: ${data.errorMessage || "لايوجد شركات شحن متاحة"}</p>
                `;
            }
        } catch (error) {
            // Handle exceptions
            console.error("Error checking OTO delivery fee:", error);
            document.getElementById("otoFeeResult").innerHTML = `
                <p>حدث خطا</p>
            `;
        }
    }
    $(".hideDiv").hide();  
    var selectedValue;var statusId = @Model.StatusOrderId;
    $("input[name='AcceptReject']").change(function () {
          selectedValue = $("input[name='AcceptReject']:checked").val();
         
        if (selectedValue === "0") {
            $(".hideDiv").hide();
            
            $(".btnshow").show();
           // console.log("طلب الارتجاع مرفوض");
        } else if (selectedValue === "1") {
            $(".hideDiv").show(); if (statusId === 15) {
                $(".btnshow").show();
            } else {
                $(".btnshow").hide();
            }
            // console.log("طلب الارتجاع مقبول");
        }
    });
    function submitDeliveryOption() {
    
        const $form = $("#processShipmentForm");
        const formData = new FormData($form[0]);
        
       
        if (!selectedValue) {
            alert("من فضلك اختار طلب الارتجاع مقبول او مرفوض");
            return;
        }
        let createReturnShipment=null; let UpdateOrderStatus=null;
        if (selectedValue==1&&statusId!=15) {
            const deliveryOptionId = $('input[name="selectedDelivery"]:checked').val();

            const pickupLocationCode = $("#pickupLocationsDropdown option:selected").val();
            if (!deliveryOptionId) {
                alert("من فضلك اختار شركة الشحن");
                return;
            }
            
            if (!pickupLocationCode&&statusId!=15) {
                alert("من فضلك اختار المخزن");
                return;
            }
            var itemsData = [];
            $(".table-items tr").not(":first").each(function () {
                var productId = $(this).data("product-id");
                var sku = parseInt($(this).find(`.sku-${productId}`).val(), 10);
                var quantity = $(this).find(`.quantity-${productId}`).val();
                itemsData.push({
                    quantity: quantity,
                    sku: sku
                });
            });
            
              createReturnShipment = {
                orderId: $("#orderId").val(),
                pickupLocationCode: pickupLocationCode,
                deliveryOptionId: deliveryOptionId,
                items: itemsData
            };

              UpdateOrderStatus = {
                orderIds:  [$("#orderId").val()],
                status: "returned",
                description: $("#comment").val()
            };
        }
       
        


        var ReturnsOrderId = parseInt($("#ReturnsOrderId").val(), 10);

        var AcceptReject = selectedValue;
        var comment = $("#comment").val();

        const AcceptReturnsOrdersDto = {
            ReturnsOrderId: ReturnsOrderId,
            comment: comment,
               // status:2
            };
        let createOrderDto = null;
        // Collect Order Data
        if (selectedValue == 1) {
             createOrderDto = {
                createReturnShipment: createReturnShipment,
                UpdateOrderStatus: UpdateOrderStatus,
                AcceptReturnsOrdersDto: AcceptReturnsOrdersDto,
                AcceptReject: true
            };
        }
        else{
            createOrderDto = {
                createReturnShipment: null,
                UpdateOrderStatus: null,
                AcceptReturnsOrdersDto: AcceptReturnsOrdersDto,
                AcceptReject: false
            };
        }
        if (createOrderDto != null) {
            $.ajax({
                url: "/Backend/ReturnOrders/ProcessShipment",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(createOrderDto),
                success: function (result) {
                    if (result.message == "مرفوض") {
                        $("#shipmentResult1").html(`
                        <p style="color: orange;">تم الحفظ</p>
                    `);
                        setTimeout(function () {
                            location.reload();
                        }, 2000);
                   }
                    else if (result && result.message) {

                        $("#shipmentResult").html(`
 
                    `); setTimeout(function () {
                            location.reload();
                        }, 2000);
                    } else {
                        $("#shipmentResult").html(`
                    <p style="color: orange;">يوجد مشكلة اثناء عملية الشحن</p>
                `);
                    }
                },
                error: function (xhr, status, error) {
               
                    const errorMessage = "حدث خطا";
                    $("#shipmentResult").html(`
                <p style="color: red;">  ${errorMessage}</p>
            `);
                     
                },
            });
        } else {
            alert("من فضلك اختار البيانات اولا");
        }
    }
