 
@model  List<Kader.DTOs.Catogry.CatogryDto >
 
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/BackEnd/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <nav aria-label="Breadcrumb">
    <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>الفئات الرئيسية (قطاعي (</span>
    </nav>
</div>
 
<fieldset>
    <legend><h2>الفئات الرئيسية (قطاعي (</h2></legend>
<div class="page-section">
    <div class="container">
        
        <table id="myTable" border="1" class="display table table-separate table-head-custom table-foot-custom">
            <thead>
                <tr>
                        <th>الفئات القطاعي الرئيسية</th>
                        <th>استعادة </th>
                       
                        
                        
                </tr>
            </thead>
            <tbody>
            @if(Model!=null)
            {
                foreach (var item in Model)
                {
                    
                     string word = item.CatogryName; // Replace with your actual model property
                        if (word.EndsWith("-قطاعي"))
                        {
                        word = word.Substring(0, word.Length - "-قطاعي".Length);
                        }
                    
                    <tr>
                        <td>
                                    @word
                        </td>
                                <td>   <input type="button" value="استعادة الفئة" class="Delete btn2 btn-default" data-val="@item.CatogryId"  /></td>
                                 
                    </tr>
                }
            }
           </tbody>
        </table>

    </div>
</div>
</fieldset>

<script>
    $(".btn2").on("click", function () {
        if (confirm("هل انت متاكد من الاستعادة")) {
            var requrl = "/Backend/Archive/RestoreDeleteCatogry";

            $.ajax({
                type: "post",
                dataType: 'json',
               // cashe: true,
                url: requrl,
                data: { id: $(this).attr('data-val') },
                success: function (json) {
                    console.log(json);
                    alert(JSON.stringify(json));
                    location.reload();
                },
              
                    error: function (xhr, status, error) {
                        console.log("XHR Response: " + xhr.responseText);
                        console.log("Status: " + status);
                        console.log("Error: " + error);
                        alert("حدث خطأ: " + xhr.responseText);
                    }
                
            });
        } else {
            // User clicked Cancel
            // Handle accordingly
        }


    });

</script>


