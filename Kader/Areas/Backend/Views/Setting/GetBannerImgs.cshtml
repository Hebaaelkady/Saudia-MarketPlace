 
@model  List<Kader.DTOs.BannerImgs.BannerImgsDto>
 
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/BackEnd/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <nav aria-label="Breadcrumb">
    <span><a asp-controller="home" asp-action="Index">الصفحة الرئيسية  </a></span> /
        <span>البانرات (</span>
    </nav>
</div>
<fieldset>
    <legend>
        <h2 class="text-dark font-weight-bold mt-2 mb-2 mr-5 din-bold d-inline">
            @if (string.IsNullOrEmpty(Context.Request.Query["Id"]))
            {
                <span>اضافة بانر جديد</span>
            }
            else
            {
                <span>تعديل لون جديد</span>
            }
        </h2>
    </legend>
    @Html.Partial("_GetBannerImgs", Model)
</fieldset>
<fieldset>
    <legend><h2>البانرات  (</h2></legend>
<div class="page-section">
    <div class="container">
        
        <table id="myTable" border="1" class="display table table-separate table-head-custom table-foot-custom">
            <thead>
                <tr>
                        <th> </th>
                        
                        <th>حذف </th>
                       
                       
                        
                </tr>
            </thead>
            <tbody>
                    @if (Model != null)
            {
                        foreach (var item in Model)
                {
                    <tr>
                        <td>
                                    <img width="500px"   src=~/Images/@item.BannerImgName />

                                </td>
                                
                                <td>   <input type="button" value="حذف " class="Delete btn2 btn-default" data-val="@item.BannerImgId" /></td>
                                
                    </tr>
                }
            }
           </tbody>
        </table>

    </div>
</div>
</fieldset>

<script>
    $(".btn2").on("click", function () {
        if (confirm("هل انت متاكد من الحذف")) {
            var requrl = "/Backend/Setting/DeleteBannerImg";

            $.ajax({
                type: "post",
                dataType: 'json',
               // cashe: true,
                url: requrl,
                data: { id: $(this).attr('data-val') },
                success: function (json) {
                    console.log(json);
                    alert(JSON.stringify(json));
                    location.reload();
                },
              
                    error: function (xhr, status, error) {
                        console.log("XHR Response: " + xhr.responseText);
                        console.log("Status: " + status);
                        console.log("Error: " + error);
                        alert("حدث خطأ: " + xhr.responseText);
                    }
                
            });
        } else {
            // User clicked Cancel
            // Handle accordingly
        }


    });

</script>


