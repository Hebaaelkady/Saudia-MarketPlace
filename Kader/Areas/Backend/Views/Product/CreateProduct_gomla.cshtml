@model Kader.DTOs.Product.Product_backendDto
<style>
    .jstree-node > .jstree-anchor > .jstree-checkbox {
        display: none;
    }

    /* Show checkbox for leaf nodes */
    .jstree-leaf > .jstree-anchor > .jstree-checkbox {
        display: inline-block;
    }
</style>
@{
    string id = Context.Request.Query["ProductId"];
}
@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.ErrorMessage
    </div>
}
<fieldset>
    <legend>
        <h2 class="text-dark font-weight-bold mt-2 mb-2 mr-5 din-bold d-inline">
            @if (string.IsNullOrEmpty(Context.Request.Query["Id"]))
            {
                <span>اضافة منتج جملة جديد</span>
            }
            else
            {
                <span>تعديل منتج جملة جديد</span>
            }
        </h2>
    </legend>


</fieldset>
