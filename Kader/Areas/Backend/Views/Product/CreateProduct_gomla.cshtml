        function updateNewQuantity() {
            let quantityAvailable = parseFloat(document.getElementById("QuantityAvailable").value) || 0;
            let quantityAdded = parseFloat(document.getElementById("QuantityAdded").value) || 0;
            let newQuantity = quantityAvailable + quantityAdded;

            document.getElementById("NewQuantity").value = newQuantity;
        }

    // Run the calculation on page load
    window.onload = function () {
        updateNewQuantity();
    };

    $('#Type').change(function (e) {
                e.preventDefault();
        var requrl = '@Url.Action("GetCatogryByType")';
                $.ajax({
                    type: "post",
                    dataType: 'json',
                    cashe: true,
                    url: requrl,
            data: { Type: $('#Type').val() },
                    success: function (data) {
                $('#CatId').empty();

                $('#CatId').append("<option value='" + "0" + "'>" + "--اختار الدرس--" + "</option>");
                        $.each(data, function (key, value) { 
                           
                        $('#CatId').append("<option value='" + value.value + "'>" + value.text + "</option>");
                        })
                    },
                    error: function (failure) {
                        alert(failure.responseText);
                    }
                });
            });
</script>
