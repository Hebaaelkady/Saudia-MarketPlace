  <script>
    function m() {


        var beforeDiscount = $('#stock').val();

        if (beforeDiscount && $.isNumeric(beforeDiscount)) {
            var discountPercent = $('input[name="MaxQuantityToShipQta3a"]').val();

            if ($.isNumeric(discountPercent)) {
                discountPercent = parseFloat(discountPercent);

                if (discountPercent > 0 && discountPercent <= 100) {
                    var afterDiscount = parseFloat(beforeDiscount)-( parseFloat(beforeDiscount) - (parseFloat(beforeDiscount) * discountPercent / 100));

                    // تحديث القيمة في div آخر
                    $('#MinQuantity').html(afterDiscount.toFixed(2));
                } else if (discountPercent > 100) {
                    alert("MaxQuantityToShipQta3a cannot be greater than 100. Resetting to default value.");
                    $('input[name="MaxQuantityToShipQta3a"]').val(100); // Reset to default value
                    var afterDiscount = parseFloat(beforeDiscount) - (parseFloat(beforeDiscount) * 100 / 100);
                    $('#MinQuantity').html(afterDiscount.toFixed(2));
                } else {
                    alert("MaxQuantityToShipQta3a must be greater than 0.");
                }
            } else {
                alert("Please enter a valid numeric value for MaxQuantityToShipQta3a.");
            }
        } else {
            alert("Please enter a valid numeric value for stock.");
        }

    }
    $(document).ready(function () {
        m();
        $('input[name="AfterDiscount"]').on('keyup change', function () {
            var beforeDiscount = $('#price').val();
            if (beforeDiscount && $.isNumeric(beforeDiscount)) {
                var discountPercent = parseFloat($(this).val())   ;
                if ($.isNumeric(discountPercent)) {
                    var afterDiscount = parseFloat(beforeDiscount) - (parseFloat(beforeDiscount) * discountPercent/100);
                    // تحديث القيمة في div آخر
                    $('#resultDiv').val(afterDiscount.toFixed(2));
                } else {
                    alert('الرجاء إدخال نسبة خصم صحيحة.');
                }
            } else {
                alert('الرجاء إدخال السعر قبل الخصم.');
            }
        });

        $('input[name="MaxQuantityToShipQta3a"]').on('keyup change', function () {
      m();
        });
    });


    $('#Type').change(function (e) {
                e.preventDefault();
        var requrl = '@Url.Action("GetCatogryByType")';
                $.ajax({
                    type: "post",
                    dataType: 'json',
                    cashe: true,
                    url: requrl,
            data: { Type: $('#Type').val() },
                    success: function (data) {
                $('#CatId').empty();

                $('#CatId').append("<option value='" + "0" + "'>" + "--اختار الدرس--" + "</option>");
                        $.each(data, function (key, value) { 
                            
                        $('#CatId').append("<option value='" + value.value + "'>" + value.text + "</option>");
                        })
                    },
                    error: function (failure) {
                        alert(failure.responseText);
                    }
                });
            });
</script>
