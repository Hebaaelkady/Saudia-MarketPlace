    $(document).ready(function () {
        $('#static_content').hide();
        $('#variable_content1').hide();
        $('input[type=radio][name=toggle]').change(function () {
            if (this.value == 'static') {
                $("#ShippingPriceDto.VarQuantity").val("");
                $("#ShippingPriceDto.VarPrice").val(""); 
                $('#static_content').show();
                $('#variable_content1').hide();
            }
            else if (this.value == 'variable') {
                $("#ShippingPrice").val(""); 
                $('#static_content').hide();
                $('#variable_content1').show();
            }
        });
    });

    

    $(document).ready(function () {
        var i = 1;                   
        $('#add_more').click(function () {
            $('#variable_content').append('<div class="input-group"><div class="form-group"><label> الكمية</label><input type="text" name="ShippingPriceDto[' + i + '].VarQuantity" class="form-control" /> </div><div class="form-group"> <label>السعر</label><input type="text" name="ShippingPriceDto[' + i + '].VarPrice" class="form-control" /></div></div>');
            i++;
        });
    });


    $(document).ready(function () {
        $('#discountBeginDate').change(function () {
            var beginDate = $(this).val();
            $('#DiscountEndDate').attr('min', beginDate);
        });
    });

    $(document).ready(function () {
        $('input[name="AfterDiscount"]').on('input', function () {
            var beforeDiscount = parseFloat($('input[name="BeforeDiscount"]').val());
            var afterDiscount = parseFloat($(this).val());

            if (afterDiscount > beforeDiscount) {
                alert('السعر بعد الخصم يجب أن يكون أقل من السعر قبل الخصم');
                $(this).val('');
            }
